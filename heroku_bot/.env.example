# Telegram API (from my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Telegram user account session string used by clone/export workers
TG_SESSION_STRING=

# Control bot token (from BotFather)
HEROKU_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot
BOT_ADMIN_USER_IDS=

# Optional defaults used by this bundle
HEROKU_RUNTIME_DIR=runtime
HEROKU_CONFIG_PATH=config.yaml
ALLOW_EMPTY_MAPPINGS=true
LEECH_BOT_USERNAME=@placeholder_bot
LEECH_BOT_ID=0

# Optional hyper download settings.
# Add one or more helper bot tokens separated by spaces.
HELPER_TOKENS=
HYPER_THREADS=0
# Recommended for WZML-style helper downloads.
# Create a private/channel dump chat, add your user session and every helper bot,
# then set its numeric chat id here. LEECH_DUMP_CHAT is also supported.
HYPER_DUMP_CHAT=

# Generate a non-black video-frame JPEG thumbnail for video/animation uploads.
GENERATE_VIDEO_THUMBNAILS=true

# Choose one Mongo mode for /export last and /clone last persistence:

# Option A: direct Mongo URI (recommended for local dev)
MONGODB_URI=
MONGODB_DATABASE=topic_ops
MONGODB_COLLECTION=bot_state

# Option B: MongoDB Data API
MONGODB_DATA_API_URL=
MONGODB_DATA_API_KEY=
MONGODB_DATA_SOURCE=
# Keep these aligned with your Data API setup
# MONGODB_DATABASE=topic_ops
# MONGODB_COLLECTION=bot_state
