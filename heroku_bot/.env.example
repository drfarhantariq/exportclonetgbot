# Telegram API (from my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Telegram user account session string used by clone/export workers
TG_SESSION_STRING=

# Control bot token (from BotFather)
HEROKU_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot
BOT_ADMIN_USER_IDS=

# Optional local deployer auth. These are only used by scripts/deploy_heroku.py
# with --write-netrc; they are not sent to the Heroku app config.
HEROKU_EMAIL=
HEROKU_API_KEY=

# Optional defaults used by this bundle
HEROKU_RUNTIME_DIR=runtime
HEROKU_CONFIG_PATH=config.yaml
ALLOW_EMPTY_MAPPINGS=true
LEECH_BOT_USERNAME=@placeholder_bot
LEECH_BOT_ID=0
RESTRICTED_MEDIA_COOLDOWN_SEC=15

# Runtime bot settings can also be changed from Telegram with:
# /settings set status_command_update_interval_sec 2
# /settings set clone_status_update_interval_sec 2

# Optional hyper download settings.
# By default the premium user session in TG_SESSION_STRING is also used as a
# hyper helper client. Add more premium user sessions for more parallelism.
TG_USE_MAIN_SESSION_AS_HELPER=true
TG_HELPER_SESSION_STRINGS=
# Add one or more helper bot tokens separated by spaces if you also want bot
# helpers. User sessions are preferred when you want premium transfer speed.
HELPER_TOKENS=
HYPER_THREADS=0
# Recommended for WZML-style helper downloads.
# Create a private/channel dump chat, add your user session and every helper bot,
# then set its numeric chat id here. LEECH_DUMP_CHAT is also supported.
HYPER_DUMP_CHAT=
HYPER_MAX_FLOOD_WAIT=120

# Generate a non-black video-frame JPEG thumbnail for video/animation uploads.
GENERATE_VIDEO_THUMBNAILS=true

# Local file used by /log.
LOG_FILE_PATH=runtime/logs/app.log

# MSZ hybrid uploader. Keep real values in Heroku config vars or local .env.
MSZ_BASE_URL=https://cloud.medicalstudyzone.com
MSZ_API_TOKEN=
MSZ_EMAIL=
MSZ_PASSWORD=
MSZ_API_MAX_BYTES=100000000
# Optional: a browser URL already opened inside the desired MSZ target folder.
MSZ_BROWSER_FOLDER_URL=
# Optional for Heroku/system Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Choose one Mongo mode for /export last and /clone last persistence:

# Option A: direct Mongo URI (recommended for local dev)
MONGODB_URI=
MONGODB_DATABASE=topic_ops
MONGODB_COLLECTION=bot_state

# Option B: MongoDB Data API
MONGODB_DATA_API_URL=
MONGODB_DATA_API_KEY=
MONGODB_DATA_SOURCE=
# Keep these aligned with your Data API setup
# MONGODB_DATABASE=topic_ops
# MONGODB_COLLECTION=bot_state
